// Toolchain in the container, interfaces on the host.
//
// Read .devcontainer/README.md first if this is new to you. Every "why" below
// is spelled out in .devcontainer/ARCHITECTURE.md — the comments here only say
// what a line is for, and point at the section that explains it.
//
// ⚙️ PROJECT marks the lines a new project has to change. `grep -rn "⚙️"
//    .devcontainer/` lists every one of them.
{
  // ═══ ① IDENTITY ══════════════════════════════════════════════════════════
  "name": "IaC Dev Environment",                                  // ⚙️ PROJECT

  // ═══ ② IMAGE ═════════════════════════════════════════════════════════════
  // Built first; features are layered on top of the finished image, which is
  // why the Dockerfile cannot use anything a feature installs.
  // → ARCHITECTURE.md "为什么 agent 不用 feature、也不进 Dockerfile"
  "build": {
    "dockerfile": "Dockerfile"
  },
  "features": {
    "ghcr.io/devcontainers/features/terraform:1": {},             // ⚙️ PROJECT
    "ghcr.io/devcontainers/features/python:1": {                  // ⚙️ PROJECT
      "version": "3.12"
    },
    "ghcr.io/devcontainers/features/github-cli:1": {},
    "ghcr.io/devcontainers/features/node:1": {
      "version": "lts"
    }
    // No coding agent here — they are installed by setup-agents.sh.
    // docker-outside-of-docker is deliberately absent: it mounts the host's
    // docker socket, which is host root for anything in this container, and
    // nothing here needs it. → ARCHITECTURE.md "features"
  },

  // ═══ ③ RUNTIME ═══════════════════════════════════════════════════════════
  "runArgs": [
    // opencode server, for the desktop app on the host to attach to. Host
    // loopback only — not exposed to the LAN. Do not use forwardPorts: the
    // devcontainer CLI parses it and never implements it.
    "--publish=127.0.0.1:4096:4096"
  ],
  "containerEnv": {
    // Lets setup-agents.sh join the container's Claude Code history to the
    // host's — the directory name is derived from the workspace path.
    "HOST_WORKSPACE_FOLDER": "${localWorkspaceFolder}"
  },
  "remoteUser": "vscode",

  // ═══ ④ DATA ══════════════════════════════════════════════════════════════
  // Home is a named volume; host binds are only for what genuinely has to be
  // shared. Anything added here must also be added to the chown prune list in
  // setup-agents.sh. → ARCHITECTURE.md "mounts"
  "mounts": [
    "source=${localEnv:HOME}/.ssh,target=/home/vscode/.ssh,readonly,type=bind",

    // ⚙️ PROJECT — one volume per project, or two projects share a home.
    "source=iac-home,target=/home/vscode,type=volume",

    // Agent state shared with the host, then the single config file in each
    // that host-setup.sh rewrites for container networking.
    "source=${localEnv:HOME}/.claude,target=/home/vscode/.claude,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer/.generated/claude/.claude.json,target=/home/vscode/.claude.json,type=bind",
    "source=${localEnv:HOME}/.codex,target=/home/vscode/.codex,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer/.generated/codex/config.toml,target=/home/vscode/.codex/config.toml,type=bind",
    "source=${localWorkspaceFolder}/.devcontainer/.generated/opencode/opencode.json,target=/home/vscode/.config/opencode/opencode.json,type=bind",
    "source=${localWorkspaceFolder}/.opencode/auth.json,target=/mnt/opencode-auth.json,type=bind",

    // WORKAROUND — the same checkout mounted a second time at its host path, so
    // the opencode desktop app and the server agree on what to call it. A
    // symlink does not work here. → ARCHITECTURE.md "同路径挂载"
    "source=${localWorkspaceFolder},target=${localWorkspaceFolder},type=bind"
  ],

  // ═══ ⑤ LIFECYCLE ═════════════════════════════════════════════════════════
  // Order below is the order these actually run.
  // → ARCHITECTURE.md "生命周期钩子"

  // HOST, every start, before the container exists: derive each agent's
  // container config from yours, and bring up Playwright MCP so the browser
  // agents drive is a real one on your screen.
  "initializeCommand": "/bin/bash .devcontainer/host-setup.sh",

  // CONTAINER, once per container. Serial on purpose — setup-agents repairs
  // mount ownership while setup-project writes into the same home directory,
  // and the object form of this field would run them in parallel.
  "postCreateCommand": "/bin/bash .devcontainer/setup-agents.sh --install && /bin/bash .devcontainer/setup-project.sh",

  // CONTAINER, every start — but not on `docker start`, which runs no hooks.
  "postStartCommand": "/bin/bash .devcontainer/setup-agents.sh --serve"

  // ═══ ⑥ EDITOR ════════════════════════════════════════════════════════════
  // Commented out, not deleted. Nothing reads it today: the toolchain runs in
  // this container but the interfaces run on the host, and .vscode-server here
  // has not been touched since 2026-08-06. The hardcoded paths below were all
  // still valid when this was disabled, so restoring it is a matter of
  // uncommenting. Put it back if you return to VS Code — without it the
  // container has no Terraform or Ansible language support, and the Ansible
  // extension cannot find its interpreter or ansible-lint.
  //
  // "customizations": {
  //   "vscode": {
  //     "extensions": [
  //       "hashicorp.terraform",
  //       "redhat.ansible",
  //       "ms-python.python",
  //       "ms-python.vscode-pylance",
  //       "ms-azuretools.vscode-docker",
  //       "mhutchie.git-graph",
  //       "anthropic.claude-code"
  //     ],
  //     "settings": {
  //       "python.defaultInterpreterPath": "/usr/local/python/current/bin/python3",
  //       "ansible.python.interpreterPath": "/usr/local/python/current/bin/python3",
  //       "ansible.ansible.path": "/home/vscode/.local/bin/ansible",
  //       "ansible.executionEnvironment.enabled": false,
  //       "ansible.validation.enabled": true,
  //       "ansible.validation.lint.enabled": true,
  //       "ansible.validation.lint.path": "/home/vscode/.local/bin/ansible-lint",
  //       "ansible.lightspeed.enabled": false,
  //       "files.associations": {
  //         "*.yml": "ansible",
  //         "*.yaml": "ansible"
  //       }
  //     }
  //   }
  // }
}
