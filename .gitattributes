# Handle line endings automatically for files detected as text
# and leave all files detected as binary untouched.
* text=auto

# Ensure consistent line endings for specific file types
*.tf text eol=lf
*.tfvars text eol=lf
*.hcl text eol=lf
*.sh text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.json text eol=lf
*.md text eol=lf

# Unified diff context uses a single space to represent a blank source line.
/scripts/hapi-workspace-web/workspace-auth.patch whitespace=-blank-at-eol

# Preserve the vendored BMad agent runtime byte-for-byte.
/.agents/** -text -whitespace

# Denote all files that are truly binary and should not be modified.
*.png binary
*.jpg binary
