[Unit]
Description=HAPI shared Hub with fixed tenant credentials
After=network-online.target
Wants=network-online.target
ConditionPathExists=/etc/hapi-shared-hub/signer-sha256

[Service]
Type=simple
User=hapi-hub
Group=hapi-hub
StateDirectory=hapi-shared-hub
StateDirectoryMode=0700
EnvironmentFile=/etc/hapi-shared-hub/hub.env
ExecStartPre=/usr/bin/python3 /usr/local/lib/hapi-hub-config.py bindings /etc/hapi-shared-hub
ExecStartPre=/usr/bin/python3 /usr/local/lib/hapi-hub-config.py migration /var/lib/hapi-shared-hub
ExecStartPre=/usr/bin/python3 /usr/local/lib/hapi-hub-config.py jwt /var/lib/hapi-shared-hub/jwt-secret.json /etc/hapi-shared-hub/signer-sha256
ExecStart=/opt/hapi-shared-hub/{{ hapi_shared_hub_artifact_sha256 }}/hapi-hub --no-relay
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/hapi-shared-hub
PrivateTmp=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
