HOME=/var/lib/hapi-shared-hub
HAPI_HOME=/var/lib/hapi-shared-hub
DB_PATH=/var/lib/hapi-shared-hub/hapi.db
HAPI_LISTEN_HOST=127.0.0.1
HAPI_LISTEN_PORT=3006
HAPI_PUBLIC_URL={{ hapi_shared_hub_origin }}
CORS_ORIGINS={{ hapi_shared_hub_origin }}
HAPI_DISABLE_PEER_TOOLS=1
HAPI_TENANT_CREDENTIALS_FILE=/etc/hapi-shared-hub/credentials.json
HAPI_IOS_PUSH=off
HAPI_ANDROID_PUSH=off
CLI_API_TOKEN={{ hapi_shared_hub_bootstrap_token }}
