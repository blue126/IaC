pid /run/hapi-hub-transport/nginx.pid;
error_log /dev/null;
worker_processes 1;
events { worker_connections 1024; }
http {
    access_log off;
    client_body_temp_path /run/hapi-hub-transport/body;
    proxy_temp_path /run/hapi-hub-transport/proxy;
    fastcgi_temp_path /run/hapi-hub-transport/fastcgi;
    uwsgi_temp_path /run/hapi-hub-transport/uwsgi;
    scgi_temp_path /run/hapi-hub-transport/scgi;
    server_tokens off;
    map $http_upgrade $hapi_connection { default close; websocket upgrade; }
    # Require the registered client certificate and source address together.
    map "$remote_addr|$ssl_client_s_dn" $hapi_namespace {
        default "";
{% for agent in hapi_shared_hub_agents %}
        "{{ agent.address }}|CN={{ agent.id }}" "{{ agent.namespace }}";
{% endfor %}
    }
    map "$remote_addr|$ssl_client_s_dn" $hapi_credential {
        default "";
{% for agent in hapi_shared_hub_agents %}
        "{{ agent.address }}|CN={{ agent.id }}" "{{ agent.credential_id }}";
{% endfor %}
    }
    server {
        listen {{ hapi_shared_hub_bind_address }}:9443 ssl;
        server_name hapi-hub.internal;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_certificate /etc/hapi-shared-hub/certificate.pem;
        ssl_certificate_key /etc/hapi-shared-hub/private.key;
        ssl_client_certificate /etc/hapi-shared-hub/ca.pem;
        ssl_crl /etc/hapi-shared-hub/crl.pem;
        ssl_verify_client on;
        ssl_verify_depth 2;
        ssl_session_cache off;
        ssl_session_tickets off;
        if ($hapi_namespace = "") { return 403; }
        if ($http_host != "hapi-hub.internal") { return 421; }
        if ($ssl_server_name != "hapi-hub.internal") { return 421; }
        client_max_body_size 64m;
        proxy_set_header Host {{ hapi_shared_hub_origin | regex_replace('^https://', '') }};
        proxy_set_header X-Hapi-Expected-Namespace $hapi_namespace;
        proxy_set_header X-Hapi-Expected-Credential $hapi_credential;
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_set_header Cookie "";
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hapi_connection;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_next_upstream off;
        proxy_redirect off;
        proxy_read_timeout 60s;
        location / { proxy_pass http://127.0.0.1:3006; }
    }
}
