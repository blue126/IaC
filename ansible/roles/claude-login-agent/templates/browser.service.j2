[Unit]
Description=Personal VM browser for Claude authorization
After=network-online.target
Wants=network-online.target

[Service]
Type=exec
User=employee
Group=employee
Environment=HOME=/home/employee
RuntimeDirectory=employee-browser
RuntimeDirectoryMode=0700
WorkingDirectory=/home/employee
ExecStart=/usr/bin/dbus-run-session -- /usr/local/lib/employee-workspace/auth-browser.py /run/employee-browser about:blank --persistent
KillMode=control-group
TimeoutStopSec=20
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
