pid /run/hapi-worker-proxy/nginx.pid;
error_log /dev/null;
worker_processes 1;
events { worker_connections 256; }
http {
    access_log off;
    client_body_temp_path /run/hapi-worker-proxy/body;
    proxy_temp_path /run/hapi-worker-proxy/proxy;
    fastcgi_temp_path /run/hapi-worker-proxy/fastcgi;
    uwsgi_temp_path /run/hapi-worker-proxy/uwsgi;
    scgi_temp_path /run/hapi-worker-proxy/scgi;
    server_tokens off;
    map $http_upgrade $hapi_connection { default close; websocket upgrade; }
    map $ssl_client_s_dn $hapi_client_allowed { default 0; "CN=hapi-control-plane" 1; }
    server {
        listen {{ hapi_worker_address }}:9443 ssl;
        server_name {{ hapi_worker_id }}.hapi.internal;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_certificate /etc/hapi-worker/server.pem;
        ssl_certificate_key /etc/hapi-worker/server.key;
        ssl_client_certificate /etc/hapi-worker/ca.pem;
        ssl_crl /etc/hapi-worker/crl.pem;
        ssl_verify_client on;
        ssl_verify_depth 2;
        ssl_session_cache off;
        ssl_session_tickets off;
        allow {{ hapi_worker_control_address }};
        deny all;
        if ($hapi_client_allowed = 0) { return 403; }
        if ($http_host != "{{ hapi_worker_id }}.hapi.internal") { return 421; }
        if ($ssl_server_name != "{{ hapi_worker_id }}.hapi.internal") { return 421; }
        add_header Cache-Control "no-store" always;
        client_max_body_size 8192;
        proxy_set_header Host {{ hapi_worker_origin | regex_replace('^https://', '') }};
        proxy_set_header Cookie "";
        proxy_set_header Authorization "";
        proxy_set_header X-Hapi-CSRF "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_set_header X-Hapi-Expected-Namespace "";
        proxy_set_header X-Hapi-Expected-Credential "";
        proxy_set_header X-Hapi-Login-Service verified-proxy;
        proxy_set_header Origin $http_origin;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hapi_connection;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_next_upstream off;
        proxy_redirect off;
        proxy_read_timeout 60s;
        location ~ ^/api/login/(status|start|code|cancel)$ {
            proxy_pass http://127.0.0.1:6082;
            proxy_request_buffering on;
        }
        location = /websockify {
            proxy_pass http://127.0.0.1:6081;
            proxy_read_timeout 1800s;
        }
        location / { return 403; }
    }
}
