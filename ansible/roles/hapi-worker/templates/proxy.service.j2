[Unit]
Description=HAPI worker restricted Claude login transport
After=network-online.target claude-login-agent.service
Wants=claude-login-agent.service

[Service]
Type=simple
User=hapi-worker-proxy
Group=hapi-worker-proxy
RuntimeDirectory=hapi-worker-proxy
RuntimeDirectoryMode=0700
ExecStartPre=/usr/sbin/nginx -t -c /etc/hapi-worker/nginx.conf -p /run/hapi-worker-proxy/
ExecStart=/usr/sbin/nginx -c /etc/hapi-worker/nginx.conf -p /run/hapi-worker-proxy/ -g "daemon off;"
Restart=on-failure
RestartSec=3
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/run/hapi-worker-proxy
PrivateTmp=true

[Install]
WantedBy=multi-user.target
