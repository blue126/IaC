# Managed HAPI Runner configuration; never include the shared Hub signer.
CLI_API_TOKEN={{ hapi_worker_api_token }}
HAPI_API_URL=http://127.0.0.1:3006
HAPI_PUBLIC_URL={{ hapi_worker_origin }}
HAPI_DISABLE_PEER_TOOLS=1
TELEGRAM_NOTIFICATION=false
SERVERCHAN_NOTIFICATION=false
HAPI_IOS_PUSH=off
HAPI_ANDROID_PUSH=off
