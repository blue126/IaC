[Unit]
Description=Qwen3.6-27B llama.cpp Compose owner
After=docker.service
Requires=docker.service
# Both runtimes bind the same loopback backend port and together they exceed
# the 48 GB of VRAM, so starting one must stop the other.
Conflicts={{ deepseek_v4_mainline_service_unit_ref }}

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ qwen36_install_dir }}
ExecStart=/usr/bin/docker compose --project-name {{ qwen36_compose_project }} up -d --no-build --pull never --force-recreate server
ExecStop=/usr/bin/docker compose --project-name {{ qwen36_compose_project }} down --remove-orphans --timeout 120
TimeoutStartSec=600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
