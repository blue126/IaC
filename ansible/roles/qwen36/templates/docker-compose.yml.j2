---
services:
  server:
    image: {{ qwen36_runtime_image }}
    entrypoint: []
    command:
      - /build/llama-server
      - --host
      - 0.0.0.0
      - --port
      - "{{ qwen36_backend_port }}"
      - --alias
      - {{ qwen36_model_name }}
      - --model
      - /models/{{ qwen36_model_file }}
      - --jinja
      - --ctx-size
      - "{{ qwen36_ctx_size }}"
      - --n-gpu-layers
      - "{{ qwen36_gpu_layers }}"
      - --split-mode
      - {{ qwen36_split_mode }}
      - --flash-attn
      - "on"
      - --cache-type-k
      - {{ qwen36_cache_type }}
      - --cache-type-v
      - {{ qwen36_cache_type }}
      - --no-mmap
{% if qwen36_spec_type | string | length > 0 %}
      - --spec-type
      - {{ qwen36_spec_type }}
      - --spec-draft-n-max
      - "{{ qwen36_spec_draft_n_max }}"
{% endif %}
    environment:
      CUDA_VISIBLE_DEVICES: "0,1"
      LD_LIBRARY_PATH: /build
    ports:
      - "127.0.0.1:{{ qwen36_backend_port }}:{{ qwen36_backend_port }}"
    volumes:
      - "{{ qwen36_runtime_bin_dir }}:/build:ro"
      - "{{ qwen36_model_dir }}:/models:ro"
    devices:
      - nvidia.com/gpu=0
      - nvidia.com/gpu=1
    ipc: host
    cap_add: [SYS_NICE]
    init: true
    restart: "no"
    stop_grace_period: 120s
