[Unit]
Description=HAPI independent workspace supervised Runner
After=hapi-workspace-hub.service
Wants=hapi-workspace-hub.service

[Service]
Type=simple
User=employee
Group=employee
WorkingDirectory=/home/employee
Environment=HOME=/home/employee
Environment=PATH=/usr/local/bin:/usr/bin:/bin
Environment=HAPI_RUNNER_SUPERVISED=1
EnvironmentFile=/etc/hapi-workspace/hapi.env
ExecStart=/opt/hapi-workspace/v0.33.2/hapi runner start-sync --workspace-root /home/employee
Restart=on-failure
RestartSec=5
UMask=0077
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
