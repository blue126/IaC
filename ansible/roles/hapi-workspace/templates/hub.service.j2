[Unit]
Description=HAPI independent workspace Hub
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=employee
Group=employee
WorkingDirectory=/home/employee
Environment=HOME=/home/employee
Environment=PATH=/usr/local/bin:/usr/bin:/bin
EnvironmentFile=/etc/hapi-workspace/hapi.env
ExecStart=/opt/hapi-workspace/v0.33.2/hapi hub --no-relay
Restart=on-failure
RestartSec=5
UMask=0077
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
