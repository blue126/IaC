pid /run/hapi-workspace-proxy/nginx.pid;
error_log /dev/null;
worker_processes 1;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    client_body_temp_path /run/hapi-workspace-proxy/body;
    proxy_temp_path /run/hapi-workspace-proxy/proxy;
    fastcgi_temp_path /run/hapi-workspace-proxy/fastcgi;
    uwsgi_temp_path /run/hapi-workspace-proxy/uwsgi;
    scgi_temp_path /run/hapi-workspace-proxy/scgi;
    server_tokens off;
    map $http_upgrade $hapi_connection { default close; websocket upgrade; }
    map $ssl_client_s_dn $hapi_client_allowed { default 0; "CN=hapi-control-plane" 1; }
    server {
        listen {{ hapi_workspace_bind_address }}:9443 ssl;
        server_name {{ hapi_workspace_id }}.hapi.internal;
        ssl_protocols TLSv1.2 TLSv1.3;
        ssl_certificate /etc/hapi-workspace/server.pem;
        ssl_certificate_key /etc/hapi-workspace/server.key;
        ssl_client_certificate /etc/hapi-workspace/ca.pem;
        ssl_crl /etc/hapi-workspace/crl.pem;
        ssl_verify_client on;
        ssl_verify_depth 2;
        ssl_session_cache off;
        ssl_session_tickets off;
        if ($hapi_client_allowed = 0) { return 403; }
        if ($http_host != "{{ hapi_workspace_id }}.hapi.internal") { return 421; }
        if ($ssl_server_name != "{{ hapi_workspace_id }}.hapi.internal") { return 421; }
        add_header Cache-Control "no-store" always;
        client_max_body_size 64m;
        root /opt/hapi-workspace/web/{{ hapi_workspace_web_sha256 }};
        proxy_set_header Host {{ hapi_workspace_origin | regex_replace('^https://', '') }};
        proxy_set_header Cookie "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hapi_connection;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_next_upstream off;
        proxy_redirect off;
        proxy_read_timeout 60s;
        location ^~ /api/push/ { return 403; }
        location ~ ^/api/login/(status|start|code|cancel)$ {
            proxy_pass http://127.0.0.1:6082;
            proxy_set_header Host {{ hapi_workspace_origin | regex_replace('^https://', '') }};
            proxy_set_header X-Hapi-Login-Service verified-proxy;
            proxy_set_header Origin $http_origin;
            proxy_set_header Cookie "";
            proxy_set_header Cf-Access-Jwt-Assertion "";
            client_max_body_size 8192;
            client_body_buffer_size 16k;
            proxy_request_buffering on;
        }
        location /api/login/ { return 404; }
        location = /websockify {
            proxy_pass http://127.0.0.1:6081;
            proxy_read_timeout 1800s;
        }
        # Other reserved control paths must not fall through to the Hub.
        location ^~ /_workspace/ { return 503; }
        location /api/ { proxy_pass http://127.0.0.1:3006; }
        location ^~ /socket.io/ { proxy_pass http://127.0.0.1:3006; }
        location / { try_files $uri $uri/ /index.html; }
    }
}
