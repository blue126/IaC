[Unit]
Description=HAPI independent workspace mTLS proxy
After=hapi-workspace-hub.service
Wants=hapi-workspace-hub.service

[Service]
Type=simple
User=hapi-workspace-proxy
Group=hapi-workspace-proxy
RuntimeDirectory=hapi-workspace-proxy
RuntimeDirectoryMode=0750
ExecStartPre=/usr/sbin/nginx -t -c /etc/hapi-workspace/nginx.conf -p /run/hapi-workspace-proxy/
ExecStart=/usr/sbin/nginx -c /etc/hapi-workspace/nginx.conf -p /run/hapi-workspace-proxy/ -g "daemon off;"
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/run/hapi-workspace-proxy
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
