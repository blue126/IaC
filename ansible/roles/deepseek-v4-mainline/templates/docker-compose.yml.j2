---
services:
  server:
    image: {{ deepseek_v4_mainline_runtime_image }}
    entrypoint: []
    command:
{% if deepseek_v4_mainline_numactl_policy %}
      - numactl
      - {{ deepseek_v4_mainline_numactl_policy }}
{% endif %}
      - /build/llama-server
      - --host
      - 0.0.0.0
      - --port
      - "{{ deepseek_v4_mainline_backend_port }}"
      - --alias
      - {{ deepseek_v4_mainline_model_name }}
      - --model
      - {{ deepseek_v4_mainline_model_path }}
      - --model-draft
      - {{ deepseek_v4_mainline_draft_model_path }}
{% if deepseek_v4_mainline_draft_device | string | length > 0 %}
      - --spec-draft-device
      - {{ deepseek_v4_mainline_draft_device }}
{% endif %}
      - --spec-type
      - {{ deepseek_v4_mainline_spec_types }}
{% if 'ngram-mod' in deepseek_v4_mainline_spec_types %}
      - --spec-ngram-mod-n-match
      - "{{ deepseek_v4_mainline_ngram_mod_n_match }}"
      - --spec-ngram-mod-n-min
      - "{{ deepseek_v4_mainline_ngram_mod_n_min }}"
      - --spec-ngram-mod-n-max
      - "{{ deepseek_v4_mainline_ngram_mod_n_max }}"
{% endif %}
      - --spec-draft-n-max
      - "{{ deepseek_v4_mainline_spec_draft_n_max }}"
      - --fit
      - "off"
      - --flash-attn
      - "on"
      - --jinja
      - --ctx-size
      - "131072"
      - --threads
      - "{{ deepseek_v4_mainline_threads }}"
      - --numa
      - distribute
      - --threads-batch
      - "36"
      - --batch-size
      - "4096"
      - --ubatch-size
      - "2048"
      - --cache-ram
      - "8192"
      - --n-gpu-layers
      - "100"
      - --split-mode
      - layer
{% if deepseek_v4_mainline_tensor_overrides %}
      - --override-tensor
      - '{{ deepseek_v4_mainline_tensor_overrides | join(",") }}'
{% endif %}
      - --cpu-moe
{% if deepseek_v4_mainline_moe_cache | string | length > 0 %}
      - --moe-cache
      - "{{ deepseek_v4_mainline_moe_cache }}"
{% endif %}
{% if deepseek_v4_mainline_repack | string | length > 0 %}
      - --{{ 'no-repack' if deepseek_v4_mainline_repack == 'off' else 'repack' }}
{% endif %}
      - --no-mmap
      - --cache-type-k
      - f16
      - --cache-type-v
      - f16
{% if deepseek_v4_mainline_log_verbosity | string | length > 0 %}
      - -lv
      - "{{ deepseek_v4_mainline_log_verbosity }}"
{% endif %}
    environment:
      CUDA_VISIBLE_DEVICES: "0,1"
      LD_LIBRARY_PATH: /build
    ports:
      - "127.0.0.1:{{ deepseek_v4_mainline_backend_port }}:{{ deepseek_v4_mainline_backend_port }}"
    volumes:
      - "{{ deepseek_v4_mainline_build_dir }}/bin:/build:ro"
      - "{{ deepseek_v4_mainline_model_dir }}:/models:ro"
    devices:
      - nvidia.com/gpu=0
      - nvidia.com/gpu=1
    ipc: host
    cap_add: [SYS_NICE]
    init: true
    restart: "no"
    stop_grace_period: 300s
