# Managed by Ansible. The Runner token comes from BWS; the Hub is the shared one on VM500,
# reached through the loopback hapi-hub-client.
CLI_API_TOKEN={{ hapi_api_token }}
HAPI_API_URL=http://127.0.0.1:3006
HAPI_DISABLE_PEER_TOOLS=1
TELEGRAM_NOTIFICATION=false
SERVERCHAN_NOTIFICATION=false
HAPI_IOS_PUSH=off
HAPI_ANDROID_PUSH=off
