[Unit]
Description=HAPI private ingress for VM500
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=hapi-ingress
Group=hapi-ingress
RuntimeDirectory=hapi-ingress
RuntimeDirectoryMode=0750
ExecStartPre=/usr/sbin/nginx -t -c /etc/hapi-ingress/nginx.conf
ExecStart=/usr/sbin/nginx -c /etc/hapi-ingress/nginx.conf -g "daemon off;"
ExecReload=/usr/sbin/nginx -c /etc/hapi-ingress/nginx.conf -s reload
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
