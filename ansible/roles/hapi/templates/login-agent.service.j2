[Unit]
Description=Personal Claude login execution agent
After=network.target

[Service]
Type=simple
User=employee
Group=employee
Environment=HOME=/home/employee
Environment=TERM=xterm-256color
UMask=0077
ExecStart=/usr/bin/python3 /usr/local/lib/claude-login-agent.py --origin {{ hapi_origin }}
Restart=on-failure
RestartSec=3
KillMode=control-group
TimeoutStopSec=15
StandardOutput=null
StandardError=null

[Install]
WantedBy=multi-user.target
