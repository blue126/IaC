pid /run/hapi-ingress/nginx.pid;
error_log /dev/null;
worker_processes 1;
events { worker_connections 256; }
http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;
    access_log off;
    client_body_temp_path /run/hapi-ingress/body;
    proxy_temp_path /run/hapi-ingress/proxy;
    fastcgi_temp_path /run/hapi-ingress/fastcgi;
    uwsgi_temp_path /run/hapi-ingress/uwsgi;
    scgi_temp_path /run/hapi-ingress/scgi;
    server_tokens off;
    map $http_upgrade $hapi_connection { default close; websocket upgrade; }
    map $remote_addr $hapi_client_allowed { default 0; "{{ hapi_control_address }}" 1; }
    server {
        listen {{ hapi_bind_address }}:9443;
        server_name {{ hapi_workspace_id }}.hapi.internal;
        if ($hapi_client_allowed = 0) { return 403; }
        if ($http_host != "{{ hapi_workspace_id }}.hapi.internal") { return 421; }
        add_header Cache-Control "no-store" always;
        client_max_body_size 64m;
        root /opt/hapi-ingress/web/{{ hapi_web_sha256 }};
        proxy_set_header Host {{ hapi_origin | regex_replace('^https://', '') }};
        proxy_set_header Cookie "";
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hapi_connection;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_next_upstream off;
        proxy_redirect off;
        proxy_read_timeout 60s;
        location ^~ /api/push/ { return 403; }
        location ~ ^/api/login/(status|start|code|cancel)$ {
            proxy_pass http://127.0.0.1:6082;
            proxy_set_header Host {{ hapi_origin | regex_replace('^https://', '') }};
            proxy_set_header X-Hapi-Login-Service verified-proxy;
            proxy_set_header Origin $http_origin;
            proxy_set_header Cookie "";
            proxy_set_header Cf-Access-Jwt-Assertion "";
            client_max_body_size 8192;
            client_body_buffer_size 16k;
            proxy_request_buffering on;
        }
        location /api/login/ { return 404; }
        # The login page's viewer is the KasmVNC desktop, through this VM's 8443 entry,
        # which alone holds the desktop credential. The role asserts the address is this VM's own,
        # so the upstream TLS hop never leaves the host.
        location = /websockify {
            proxy_pass https://{{ hapi_desktop_address }}:8443/websockify;
            proxy_set_header Host {{ hapi_desktop_address }};
            proxy_set_header Origin https://{{ hapi_desktop_address }}:8443;
            # Location-level headers replace the server's, so the upgrade and the
            # stripped credentials are set again here.
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $hapi_connection;
            proxy_set_header Cookie "";
            proxy_set_header Cf-Access-Jwt-Assertion "";
            proxy_ssl_server_name off;
            proxy_read_timeout 1800s;
        }
        # Other reserved control paths must not fall through to the Hub.
        location ^~ /_workspace/ { return 503; }
        location /api/ { proxy_pass http://127.0.0.1:3006; }
        location ^~ /socket.io/ { proxy_pass http://127.0.0.1:3006; }
        location / { try_files $uri $uri/ /index.html; }
    }
}
