# Managed by Ansible. Secrets are supplied by Ansible Vault.
NODE_ENV=production
PORT=3000
DATABASE_URL=
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=bookorbit
POSTGRES_DB=bookorbit
POSTGRES_PASSWORD={{ bookorbit_db_password }}
JWT_SECRET={{ bookorbit_jwt_secret }}
PODCAST_ENCRYPTION_KEY={{ bookorbit_podcast_encryption_key }}
SETUP_BOOTSTRAP_TOKEN={{ bookorbit_setup_bootstrap_token }}
APP_URL=https://{{ bookorbit_public_domain }}
CLIENT_URL=https://{{ bookorbit_public_domain }}
TZ={{ bookorbit_timezone }}
PUID={{ bookorbit_uid }}
PGID={{ bookorbit_gid }}
NODE_MAX_OLD_SPACE_SIZE=2048
BOOK_DOCK_PATH=
LIBRARY_BROWSE_ROOT=/books
DISABLE_LOCAL_AUTH=false
