pid /run/hapi-control-proxy/nginx.pid;
error_log /dev/null;
worker_processes 1;
events { worker_connections 1024; }
http {
    include /etc/nginx/mime.types;
    access_log off;
    client_body_temp_path /run/hapi-control-proxy/body;
    proxy_temp_path /run/hapi-control-proxy/proxy;
    fastcgi_temp_path /run/hapi-control-proxy/fastcgi;
    uwsgi_temp_path /run/hapi-control-proxy/uwsgi;
    scgi_temp_path /run/hapi-control-proxy/scgi;
    server_tokens off;
    map $http_upgrade $hapi_connection { default close; websocket upgrade; }
{% for route in hapi_control_plane_routes %}
    upstream hapi_{{ route.workspace_id | replace('-', '_') }} {
        server unix:/run/hapi-control-plane/routes/{{ route.workspace_id }}.sock;
    }
    # The revocation relay can reach only this fixed private bridge.
    server {
        listen unix:/run/hapi-control-proxy/bridges/{{ route.workspace_id }}.sock;
        server_name {{ route.backend_name }};
        if ($http_x_hapi_expected_route != "{{ route | to_json(sort_keys=True, separators=[',', ':']) | hash('sha256') }}") { return 409; }
        proxy_pass_request_headers on;
        client_max_body_size 64m;
        proxy_set_header Host {{ route.backend_name }};
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_set_header Cookie "";
        proxy_set_header X-Hapi-Stream-Lease "";
        proxy_set_header X-Hapi-Expected-Route "";
        proxy_set_header X-Hapi-CSRF "";
        proxy_set_header X-Hapi-Expected-Namespace "{{ route.namespace | default('default') }}";
        proxy_set_header X-Hapi-Expected-Credential "";
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hapi_connection;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_max_temp_file_size 0;
        proxy_next_upstream off;
        proxy_redirect off;
        proxy_read_timeout 60s;
        location / {
{% if hapi_control_plane_shared_hub | default(false) %}
            proxy_pass http://127.0.0.1:3006;
{% else %}
            proxy_pass http://{{ route.backend_address }}:9443;
{% endif %}
        }
        location ^~ /api/login/ {
            proxy_pass http://{{ route.backend_address }}:9443;
        }
        location = /websockify {
            proxy_pass http://{{ route.backend_address }}:9443;
            proxy_read_timeout 1800s;
        }
    }
{% endfor %}
    server {
        listen 127.0.0.1:8080;
        server_name {{ hapi_control_plane_origin | regex_replace('^https://', '') }};
        if ($http_host != "{{ hapi_control_plane_origin | regex_replace('^https://', '') }}") { return 421; }
        client_max_body_size 64m;
        add_header Cache-Control "no-store" always;
        add_header X-Content-Type-Options nosniff always;
        add_header Referrer-Policy no-referrer always;
        proxy_set_header Host $hapi_tls_name;
        proxy_set_header X-Hapi-Stream-Lease $hapi_stream_lease;
        proxy_set_header Cf-Access-Jwt-Assertion "";
        proxy_set_header Cf-Access-Authenticated-User-Email "";
        proxy_set_header Cookie "";
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection $hapi_connection;
        proxy_buffering off;
        proxy_request_buffering off;
        proxy_cache off;
        proxy_max_temp_file_size 0;
        proxy_next_upstream off;
        proxy_redirect off;
        proxy_read_timeout 60s;
        location ^~ /api/push/ { return 403; }
        location = /api/auth { return 403; }
        # Login execution is reachable only through its CSRF-protected prefix.
        location = /api/login { return 403; }
        location ^~ /api/login/ { return 403; }
        location = /websockify { return 403; }
        location = /_hapi_authorize {
            internal;
            proxy_pass http://unix:/run/hapi-control-plane/auth.sock:/authorize;
            proxy_pass_request_body off;
            proxy_set_header Content-Length "";
            proxy_set_header Host $http_host;
            proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
            proxy_set_header X-Hapi-Method $hapi_original_method;
            proxy_set_header X-Hapi-Resource $hapi_resource;
            proxy_set_header X-Hapi-CSRF $http_x_hapi_csrf;
            proxy_set_header Origin $http_origin;
            proxy_set_header Upgrade $http_upgrade;
        }
        location ~ ^/_workspace/(identity|session|logout)$ {
            client_max_body_size 64;
            proxy_pass http://unix:/run/hapi-control-plane/auth.sock;
            proxy_set_header Host $http_host;
            proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
            proxy_set_header Origin $http_origin;
            proxy_set_header X-Hapi-CSRF $http_x_hapi_csrf;
            proxy_set_header Cookie "";
            proxy_set_header X-Hapi-Stream-Lease "";
            proxy_set_header X-Hapi-Expected-Route "";
        }
        location = /_workspace/login { return 308 /_workspace/login/; }
        location = /_workspace/login/ {
            proxy_pass http://unix:/run/hapi-control-plane/auth.sock;
            proxy_set_header Host $http_host;
            proxy_set_header Cf-Access-Jwt-Assertion $http_cf_access_jwt_assertion;
            proxy_set_header Origin $http_origin;
            proxy_set_header Cookie "";
            proxy_set_header X-Hapi-Stream-Lease "";
            proxy_set_header X-Hapi-Expected-Route "";
            proxy_set_header X-Hapi-CSRF "";
        }
        location ~ ^/_workspace/login/(guide\.js|guide\.css)$ {
            include /etc/hapi-control-plane/authorize.inc;
            alias /usr/local/lib/hapi-login-portal/$1;
            limit_except GET { deny all; }
        }
        location ~ ^/_workspace/login/(core|vendor|app|include)/(.*)$ {
            include /etc/hapi-control-plane/authorize.inc;
            alias /usr/share/novnc/$1/$2;
            limit_except GET { deny all; }
        }
        location ~ ^/_workspace/login/api/login/(status|start|code|cancel)$ {
            set $hapi_login_action $1;
            include /etc/hapi-control-plane/authorize.inc;
            set $hapi_resource login;
            client_max_body_size 8192;
            client_body_buffer_size 16k;
            proxy_request_buffering on;
            proxy_pass http://$hapi_backend/api/login/$hapi_login_action;
        }
        location = /_workspace/login/websockify {
            include /etc/hapi-control-plane/authorize.inc;
            proxy_pass http://$hapi_backend/websockify;
            proxy_read_timeout 1800s;
        }
        location /_workspace/ { return 503; }
        location / {
            include /etc/hapi-control-plane/authorize.inc;
            proxy_pass http://$hapi_backend;
        }
    }
}
