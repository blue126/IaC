[Unit]
Description=HAPI prototype private reverse proxy
After=hapi-control-auth.service
Requires=hapi-control-auth.service

[Service]
Type=simple
User=hapi-proxy
Group=hapi-proxy
RuntimeDirectory=hapi-control-proxy
RuntimeDirectoryMode=0750
ExecStartPre=/usr/bin/install -d -m 0750 /run/hapi-control-proxy/bridges
ExecStartPre=/usr/sbin/nginx -t -c /etc/hapi-control-plane/nginx.conf -p /run/hapi-control-proxy/
ExecStart=/usr/sbin/nginx -c /etc/hapi-control-plane/nginx.conf -p /run/hapi-control-proxy/ -g "daemon off;"
ExecReload=/usr/sbin/nginx -c /etc/hapi-control-plane/nginx.conf -p /run/hapi-control-proxy/ -s reload
Restart=on-failure
RestartSec=5
UMask=0007
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/run/hapi-control-proxy
ProtectHome=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
