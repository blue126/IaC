services:
  open-webui:
    image: "{{ open_webui_gateway_image_repository }}@{{ open_webui_gateway_image_digest }}"
    container_name: "{{ open_webui_gateway_container_name }}"
    restart: unless-stopped
    privileged: false
    security_opt:
      - no-new-privileges:true
    ports:
      - "{{ open_webui_gateway_bind_address }}:{{ open_webui_gateway_port }}:{{ open_webui_gateway_container_port }}"
    environment:
      # LLM backend on llm-workstation (llama.cpp, OpenAI-compatible).
      OPENAI_API_BASE_URL: "{{ open_webui_gateway_llm_base_url }}"
      OPENAI_API_KEY: not-needed
      # No Ollama backend anywhere in this deployment; disable the
      # connector so the UI does not repeatedly log connection errors.
      ENABLE_OLLAMA_API: "false"
      # TTS backend on llm-workstation (Qwen3-TTS, OpenAI-compatible
      # /v1/audio/speech).
      AUDIO_TTS_ENGINE: openai
      AUDIO_TTS_OPENAI_API_BASE_URL: "{{ open_webui_gateway_tts_base_url }}"
      AUDIO_TTS_OPENAI_API_KEY: not-needed
      AUDIO_TTS_MODEL: "{{ open_webui_gateway_tts_model }}"
      AUDIO_TTS_VOICE: "{{ open_webui_gateway_tts_voice }}"
    volumes:
      - "{{ open_webui_gateway_data_dir }}:/app/backend/data:rw"
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"
