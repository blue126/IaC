# Managed by Ansible (oci-hub-mosh). Native `mosh` starts the system
# mosh-server over SSH; give it the workspace network timeout. LC_CTYPE
# overrides a client value Linux lacks (macOS sends LC_CTYPE=UTF-8), which
# mosh-server would otherwise reject. One line: a Match SetEnv replaces any
# global SetEnv for this user.
Match User employee
    SetEnv MOSH_SERVER_NETWORK_TMOUT={{ oci_hub_mosh_network_timeout }} LC_CTYPE=C.UTF-8
# Close the Match block so later sshd_config.d files stay global.
Match all
