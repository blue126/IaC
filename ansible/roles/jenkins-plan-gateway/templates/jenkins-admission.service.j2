[Unit]
Description=Trusted Jenkins build metadata and stage admission service
After=network-online.target

[Service]
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/jenkins-plan-gateway/controller-admission.py
Restart=on-failure
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateDevices=true
PrivateIPC=true
NoNewPrivileges=true
MemoryMax=128M
ReadWritePaths=/var/lib/jenkins-control

[Install]
WantedBy=multi-user.target
