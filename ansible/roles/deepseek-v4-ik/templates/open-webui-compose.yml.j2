services:
  open-webui:
    image: ghcr.io/open-webui/open-webui:main
    container_name: {{ deepseek_v4_ik_webui_container }}
    restart: unless-stopped
    ports:
      - "3000:8080"
    extra_hosts:
      - "host.docker.internal:host-gateway"
    environment:
      - OPENAI_API_BASE_URL={{ deepseek_v4_ik_webui_target_url }}
      - OPENAI_API_KEY=not-needed
    volumes:
      - /opt/open-webui/data:/app/backend/data
    depends_on:
      searxng:
        condition: service_healthy
    logging:
      driver: json-file
      options:
        max-size: "50m"
        max-file: "3"

  searxng:
    image: searxng/searxng:latest
    container_name: searxng
    restart: unless-stopped
    volumes:
      - /opt/open-webui/searxng:/etc/searxng:rw
    healthcheck:
      test: ["CMD", "wget", "--quiet", "--tries=1", "--spider", "http://localhost:8080/healthz"]
      interval: 30s
      timeout: 5s
      retries: 3
      start_period: 10s
    logging:
      driver: json-file
      options:
        max-size: "10m"
        max-file: "3"
