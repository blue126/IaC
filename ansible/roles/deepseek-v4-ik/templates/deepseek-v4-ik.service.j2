[Unit]
Description=DeepSeek V4 GGUF ik_llama.cpp Compose owner
After=docker.service
Requires=docker.service
Conflicts={{ deepseek_v4_ik_main_unit }}

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ deepseek_v4_ik_install_dir }}
ExecStart=/usr/bin/docker compose --project-name {{ deepseek_v4_ik_compose_project }} up -d --no-build --pull never --no-recreate candidate
ExecStop=/usr/bin/docker compose --project-name {{ deepseek_v4_ik_compose_project }} stop candidate
TimeoutStartSec=1200
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
