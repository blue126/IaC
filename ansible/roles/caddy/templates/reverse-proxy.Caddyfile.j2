{{ caddy_reverse_proxy_domain }} {
{% if caddy_reverse_proxy_pre_directives is defined %}
{{ caddy_reverse_proxy_pre_directives | indent(4, first=true) }}
{% endif %}
    reverse_proxy {{ caddy_reverse_proxy_upstream }}

    header {
        X-Content-Type-Options nosniff
        Strict-Transport-Security "max-age=31536000; includeSubDomains"
        -Server
    }
}
