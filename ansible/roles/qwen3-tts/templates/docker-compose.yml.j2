---
services:
  server:
    image: "{{ qwen3_tts_vllm_image }}"
    command:
      - vllm-omni
      - serve
      - "{{ qwen3_tts_model_repository }}"
      - --deploy-config
      - /opt/qwen3-tts/vllm-deploy-config.yaml
      - --host
      - 0.0.0.0
      - --port
      - "{{ qwen3_tts_container_port }}"
      - --trust-remote-code
      - --omni
    environment:
      HF_HOME: /root/.cache/huggingface
      NVIDIA_DRIVER_CAPABILITIES: compute,utility
      VLLM_WORKER_MULTIPROC_METHOD: spawn
      SPEAKER_SAMPLES_DIR: /opt/qwen3-tts/profiles
    volumes:
      - "{{ qwen3_tts_model_cache_dir }}:/root/.cache/huggingface"
      - "{{ qwen3_tts_vllm_cache_dir }}:/root/.cache/vllm"
      - "{{ qwen3_tts_profile_dir }}:/opt/qwen3-tts/profiles"
      - "{{ qwen3_tts_vllm_deploy_config_path }}:/opt/qwen3-tts/vllm-deploy-config.yaml:ro"
    expose:
      - "{{ qwen3_tts_container_port }}"
    devices:
      - nvidia.com/gpu={{ qwen3_tts_gpu_ordinal }}
    ipc: host
    healthcheck:
      test:
        - CMD
        - python3
        - -c
        - >-
          import urllib.request;
          urllib.request.urlopen(
          'http://localhost:{{ qwen3_tts_container_port }}/health', timeout=5)
      interval: 30s
      timeout: 10s
      start_period: 900s
      retries: 3
    init: true
    restart: "no"
    stop_grace_period: 120s

  shim:
    image: "{{ qwen3_tts_shim_image }}"
    command:
      - python
      - /opt/qwen3-tts-shim.py
    depends_on:
      server:
        condition: service_healthy
    environment:
      HOST: 0.0.0.0
      PORT: "{{ qwen3_tts_shim_container_port }}"
      UPSTREAM_MODEL: "{{ qwen3_tts_model_repository }}"
      UPSTREAM_URL: "http://server:{{ qwen3_tts_container_port }}"
      VOICE_ALIASES_JSON: '{{ qwen3_tts_voice_aliases | to_json }}'
      BASE_PROFILE: "{{ qwen3_tts_profile_name }}"
      TTS_MODE: "{{ qwen3_tts_mode }}"
    ports:
      - "{{ qwen3_tts_bind_address }}:{{ qwen3_tts_port }}:{{ qwen3_tts_shim_container_port }}"
    volumes:
      - "{{ qwen3_tts_install_dir }}/qwen3-tts-shim.py:/opt/qwen3-tts-shim.py:ro"
    healthcheck:
      test:
        - CMD
        - python
        - -c
        - >-
          import urllib.request; assert urllib.request.urlopen(
          'http://localhost:{{ qwen3_tts_shim_container_port }}/health', timeout=5).status == 200
      interval: 30s
      timeout: 10s
      start_period: 60s
      retries: 3
    init: true
    restart: "no"

  voice-design:
    image: "{{ qwen3_tts_vllm_image }}"
    command:
      - vllm-omni
      - serve
      - "{{ qwen3_tts_voice_design_model_repository }}"
      - --deploy-config
      - /opt/qwen3-tts/vllm-deploy-config.yaml
      - --host
      - 0.0.0.0
      - --port
      - "{{ qwen3_tts_container_port }}"
      - --trust-remote-code
      - --omni
    environment:
      HF_HOME: /root/.cache/huggingface
      NVIDIA_DRIVER_CAPABILITIES: compute,utility
      VLLM_WORKER_MULTIPROC_METHOD: spawn
    volumes:
      - "{{ qwen3_tts_model_cache_dir }}:/root/.cache/huggingface"
      - "{{ qwen3_tts_vllm_cache_dir }}:/root/.cache/vllm"
      - "{{ qwen3_tts_vllm_deploy_config_path }}:/opt/qwen3-tts/vllm-deploy-config.yaml:ro"
      - "{{ qwen3_tts_install_dir }}/qwen3-tts-profile-bootstrap.py:/opt/qwen3-tts-profile-bootstrap.py:ro"
      - "{{ qwen3_tts_profile_dir }}:/opt/qwen3-tts/profiles"
    expose:
      - "{{ qwen3_tts_container_port }}"
    devices:
      - nvidia.com/gpu={{ qwen3_tts_gpu_ordinal }}
    ipc: host
    init: true
    restart: "no"

  profile-bootstrap:
    image: "{{ qwen3_tts_shim_image }}"
    command: [python, /opt/qwen3-tts-profile-bootstrap.py]
    environment:
      BASE_PROFILE: "{{ qwen3_tts_profile_name }}"
      PROFILE_REFERENCE_FILE: /opt/qwen3-tts/profiles/audiobook_narrator_zh-reference.wav
      PROFILE_REFERENCE_TEXT: {{ qwen3_tts_profile_reference_text | to_json }}
      VOICE_DESIGN_INSTRUCTIONS: {{ qwen3_tts_voice_design_instructions | to_json }}
      VOICE_DESIGN_MODEL: "{{ qwen3_tts_voice_design_model_repository }}"
      BASE_MODEL: "{{ qwen3_tts_base_model_repository }}"
      PRODUCTION_PROFILE: "{{ qwen3_tts_profile_name }}"
      BASE_URL: "http://server:{{ qwen3_tts_container_port }}"
      VOICE_DESIGN_URL: "http://voice-design:{{ qwen3_tts_container_port }}"
    volumes:
      - "{{ qwen3_tts_install_dir }}/qwen3-tts-profile-bootstrap.py:/opt/qwen3-tts-profile-bootstrap.py:ro"
      - "{{ qwen3_tts_profile_dir }}:/opt/qwen3-tts/profiles"
    restart: "no"
