[Unit]
Description=Qwen3-TTS OpenAI-compatible API and local shim
After=docker.service
Requires=docker.service
# Ordering only, no Requires: TTS must still come up if Qwen3.8 fails.
# Both are enabled at boot and share GPU 1, and both size their GPU
# allocations at startup, so this makes the boot order match the one
# that has been measured rather than leaving it to systemd's discretion.
After=qwen38.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory={{ qwen3_tts_install_dir }}
ExecStart=/usr/bin/docker compose --project-name {{ qwen3_tts_compose_project }} --file {{ qwen3_tts_install_dir }}/compose.yml up -d --pull missing --force-recreate server shim
ExecStop=/usr/bin/docker compose --project-name {{ qwen3_tts_compose_project }} --file {{ qwen3_tts_install_dir }}/compose.yml down --remove-orphans --timeout 120
TimeoutStartSec=3600
TimeoutStopSec=180

[Install]
WantedBy=multi-user.target
