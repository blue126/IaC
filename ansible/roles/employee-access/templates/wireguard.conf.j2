[Interface]
Address = {{ employee_access_wireguard_address }}
ListenPort = 51820
PrivateKey = {{ employee_access_wireguard_private_key }}
Table = off
{% for name, device in employee_access_devices | dictsort %}
{% if device.enabled | bool and not employee_access_networks[device.employee].disabled | bool %}

[Peer]
PublicKey = {{ device.wireguard_public_key }}
AllowedIPs = {{ device.address }}/32
{% endif %}
{% endfor %}
