worker_processes 1;
pid /run/employee-auth-viewer/nginx.pid;
error_log stderr warn;
events { worker_connections 128; }
http {
    access_log off;
    map $remote_addr $employee_backend {
        default "";
{% for name, device in employee_access_devices | dictsort %}
{% if device.enabled | bool and not employee_access_networks[device.employee].disabled | bool %}
        {{ device.address }} {{ employee_access_networks[device.employee].ip }}:6081;
{% endif %}
{% endfor %}
    }
    map $http_origin $employee_same_origin {
        default 0;
        "http://{{ employee_access_wireguard_address.split('/')[0] }}:8443" 1;
    }
    server {
        listen {{ employee_access_wireguard_address.split('/')[0] }}:8443;
        server_name {{ employee_access_wireguard_address.split('/')[0] }};
        if ($http_host != "{{ employee_access_wireguard_address.split('/')[0] }}:8443") { return 403; }
        if ($employee_backend = "") { return 403; }
        add_header Cache-Control "no-store" always;
        add_header X-Frame-Options DENY always;
        add_header Referrer-Policy no-referrer always;
        add_header X-Content-Type-Options nosniff always;
        client_max_body_size 1k;
        location = / { return 302 /vnc.html; }
        location = /websockify {
            if ($employee_same_origin = 0) { return 403; }
            proxy_pass http://$employee_backend;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_read_timeout 1800s;
            proxy_buffering off;
        }
        location ~ ^/(vnc\.html|app/[a-zA-Z0-9_./-]+|core/[a-zA-Z0-9_./-]+|vendor/[a-zA-Z0-9_./-]+|defaults\.json|mandatory\.json)$ {
            limit_except GET { deny all; }
            proxy_pass http://$employee_backend;
            proxy_set_header Host $host;
            proxy_buffering off;
        }
        location / { return 404; }
    }
}
