# No host addresses, VLAN trunks, IPv6, or arbitrary L2 access on employee bridges.
table bridge employee_boundary {}
delete table bridge employee_boundary
table bridge employee_boundary {
  chain input {
    type filter hook input priority -200; policy accept;
{% for id, net in employee_access_networks | dictsort %}
    iifname "tap{{ net.vmid }}i0" drop
    iifname "tap{{ employee_access_vmid }}i{{ net.gateway_nic }}" drop
{% endfor %}
  }
  chain forward {
    type filter hook forward priority -200; policy accept;
{% for id, net in employee_access_networks | dictsort %}
{% if not net.disabled | bool %}
    iifname "tap{{ net.vmid }}i0" oifname "tap{{ employee_access_vmid }}i{{ net.gateway_nic }}" ether saddr {{ net.mac_address }} ether type ip ip saddr {{ net.ip }} accept
    iifname "tap{{ net.vmid }}i0" oifname "tap{{ employee_access_vmid }}i{{ net.gateway_nic }}" ether saddr {{ net.mac_address }} ether type arp arp saddr ip {{ net.ip }} arp daddr ip {{ net.gateway }} accept
    iifname "tap{{ employee_access_vmid }}i{{ net.gateway_nic }}" oifname "tap{{ net.vmid }}i0" ether saddr {{ net.gateway_mac }} ether type { ip, arp } accept
{% endif %}
    iifname "tap{{ net.vmid }}i0" drop
    iifname "tap{{ employee_access_vmid }}i{{ net.gateway_nic }}" drop
{% endfor %}
  }
  chain output {
    type filter hook output priority -200; policy accept;
{% for id, net in employee_access_networks | dictsort %}
    oifname "tap{{ net.vmid }}i0" drop
    oifname "tap{{ employee_access_vmid }}i{{ net.gateway_nic }}" drop
{% endfor %}
  }
}
