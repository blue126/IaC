[Unit]
Description=Employee managed SSH entry
Requires=employee-firewall.service wg-quick@wg-employee.service
After=employee-firewall.service wg-quick@wg-employee.service

[Service]
ExecStartPre=/usr/sbin/sshd -t -f /etc/ssh/employee-sshd.conf
ExecStart=/usr/sbin/sshd -D -f /etc/ssh/employee-sshd.conf
ExecReload=/bin/kill -HUP $MAINPID
KillMode=control-group
Restart=on-failure

[Install]
WantedBy=multi-user.target
