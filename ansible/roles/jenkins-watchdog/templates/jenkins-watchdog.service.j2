[Unit]
Description=Independent Jenkins maintenance and recovery watchdog
After=network-online.target

[Service]
Slice=jenkins-control.slice
Type=simple
User=root
UMask=0077
ExecStart=/usr/bin/python3 /opt/jenkins-watchdog/watchdog.py watch
Restart=on-failure
RestartSec=5
MemoryMax=128M
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/jenkins-agent-control /run

[Install]
WantedBy=multi-user.target
