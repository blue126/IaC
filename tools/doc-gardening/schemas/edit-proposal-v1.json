{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Document gardening exact edit proposal v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "kind", "manifest_sha256", "document_path", "revision", "candidate_id", "hunk_id", "source", "evidence_refs", "edit"],
  "properties": {
    "schema_version": {"const": 1},
    "kind": {"const": "edit_proposal"},
    "manifest_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "document_path": {"type": "string"},
    "revision": {
      "type": "object",
      "additionalProperties": false,
      "required": ["base", "head"],
      "properties": {
        "base": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
        "head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "candidate_id": {"type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$"},
    "hunk_id": {"type": "string"},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["span_id", "quote"],
      "properties": {"span_id": {"type": "string"}, "quote": {"type": "string"}}
    },
    "evidence_refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}},
    "edit": {
      "type": "object",
      "additionalProperties": false,
      "required": ["find", "replace"],
      "properties": {"find": {"type": "string", "minLength": 1}, "replace": {"type": "string"}}
    }
  }
}
