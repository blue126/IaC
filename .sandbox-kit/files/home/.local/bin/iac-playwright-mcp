#!/bin/sh
set -eu

chromium_path="${IAC_PLAYWRIGHT_CHROMIUM_PATH:-/usr/local/bin/iac-chromium}"

if [ ! -x "$chromium_path" ]; then
  echo "Playwright Chromium executable is missing or not executable: $chromium_path" >&2
  exit 1
fi

exec playwright-mcp --headless --isolated --executable-path "$chromium_path" "$@"
